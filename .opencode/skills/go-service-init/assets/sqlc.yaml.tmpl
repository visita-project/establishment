version: "2"
sql:
  - engine: postgresql
    schema: "migrations"
    queries: "internal/infra/storage/postgres/queries"
    gen:
      go:
        package: sqlc
        out: "gen/sqlc"
        sql_package: pgx/v5
        emit_json_tags: true
        emit_prepared_queries: false
        emit_interface: true
        emit_pointers_for_null_types: true